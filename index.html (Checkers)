<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkers - Play vs Bot or 2 Player</title>
  <style>
    :root {
      --bg-color: #1e1e24;
      --board-dark: #b58863;
      --board-light: #f0d9b5;
      --red-piece: #c93b2b;
      --black-piece: #222222;
      --highlight: #7bfa7b;
    }

    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    h1 {
      margin-bottom: 10px;
      font-size: 2rem;
    }

    .menu {
      margin-bottom: 20px;
      display: flex;
      gap: 15px;
    }

    button {
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 10px 20px;
      font-size: 1rem;
      border-radius: 5px;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover {
      background-color: #45a049;
    }

    #status {
      font-size: 1.2rem;
      margin-bottom: 15px;
      font-weight: bold;
    }

    #board-container {
      display: grid;
      grid-template-columns: repeat(8, 60px);
      grid-template-rows: repeat(8, 60px);
      border: 6px solid #444;
      border-radius: 4px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .square {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .light {
      background-color: var(--board-light);
    }

    .dark {
      background-color: var(--board-dark);
    }

    .piece {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      cursor: pointer;
      box-shadow: inset 0 3px 6px rgba(255,255,255,0.4), 0 3px 6px rgba(0,0,0,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
      user-select: none;
    }

    .piece.red {
      background-color: var(--red-piece);
      color: white;
    }

    .piece.black {
      background-color: var(--black-piece);
      color: white;
    }

    .piece.king::after {
      content: '★';
      font-size: 1.4rem;
      color: gold;
    }

    .square.selected {
      outline: 3px solid var(--highlight);
      outline-offset: -3px;
    }

    .square.valid-move::after {
      content: '';
      width: 15px;
      height: 15px;
      background-color: var(--highlight);
      border-radius: 50%;
      display: block;
    }
  </style>
</head>
<body>

  <h1>Checkers Game</h1>
  <div class="menu">
    <button onclick="startGame('bot')">Play vs Bot</button>
    <button onclick="startGame('2p')">2 Player Game</button>
  </div>
  
  <div id="status">Select a game mode to start!</div>
  <div id="board-container"></div>

  <script>
    const BOARD_SIZE = 8;
    let board = [];
    let turn = 'red'; // red starts
    let gameMode = null; // 'bot' or '2p'
    let selectedPiece = null;
    let validMoves = [];

    const boardContainer = document.getElementById('board-container');
    const statusText = document.getElementById('status');

    function startGame(mode) {
      gameMode = mode;
      turn = 'red';
      selectedPiece = null;
      validMoves = [];
      initBoard();
      renderBoard();
      updateStatus();
    }

    function initBoard() {
      board = Array(BOARD_SIZE).fill(null).map(() => Array(BOARD_SIZE).fill(null));
      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          if ((r + c) % 2 === 1) {
            if (r < 3) {
              board[r][c] = { color: 'black', king: false };
            } else if (r > 4) {
              board[r][c] = { color: 'red', king: false };
            }
          }
        }
      }
    }

    function renderBoard() {
      boardContainer.innerHTML = '';
      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          const square = document.createElement('div');
          square.classList.add('square', (r + c) % 2 === 1 ? 'dark' : 'light');
          square.dataset.row = r;
          square.dataset.col = c;

          const piece = board[r][c];
          if (piece) {
            const pieceEl = document.createElement('div');
            pieceEl.classList.add('piece', piece.color);
            if (piece.king) pieceEl.classList.add('king');
            square.appendChild(pieceEl);
          }

          if (selectedPiece && selectedPiece.r === r && selectedPiece.c === c) {
            square.classList.add('selected');
          }

          if (validMoves.some(m => m.r === r && m.c === c)) {
            square.classList.add('valid-move');
          }

          square.addEventListener('click', () => onSquareClick(r, c));
          boardContainer.appendChild(square);
        }
      }
    }

    function updateStatus() {
      if (!gameMode) return;
      if (gameMode === 'bot' && turn === 'black') {
        statusText.textContent = "Bot's turn...";
        setTimeout(botMove, 600);
      } else {
        statusText.textContent = `Current Turn: ${turn.toUpperCase()} (${turn === 'red' ? 'Player 1' : (gameMode === 'bot' ? 'Bot' : 'Player 2')})`;
      }
    }

    function getValidMoves(r, c) {
      const piece = board[r][c];
      if (!piece) return [];
      const moves = [];
      const dirs = [];

      if (piece.color === 'red' || piece.king) {
        dirs.push([-1, -1], [-1, 1]);
      }
      if (piece.color === 'black' || piece.king) {
        dirs.push([1, -1], [1, 1]);
      }

      for (let [dr, dc] of dirs) {
        let nr = r + dr;
        let nc = c + dc;
        if (inBounds(nr, nc)) {
          if (!board[nr][nc]) {
            moves.push({ r: nr, c: nc, jump: null });
          } else if (board[nr][nc].color !== piece.color) {
            let nnr = nr + dr;
            let nnc = nc + dc;
            if (inBounds(nnr, nnc) && !board[nnr][nnc]) {
              moves.push({ r: nnr, c: nnc, jump: { r: nr, c: nc } });
            }
          }
        }
      }
      return moves;
    }

    function inBounds(r, c) {
      return r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE;
    }

    function onSquareClick(r, c) {
      if (gameMode === 'bot' && turn === 'black') return;

      const piece = board[r][c];

      if (selectedPiece) {
        const move = validMoves.find(m => m.r === r && m.c === c);
        if (move) {
          executeMove(selectedPiece.r, selectedPiece.c, move);
          selectedPiece = null;
          validMoves = [];
          renderBoard();
          checkWin();
          switchTurn();
          return;
        }
      }

      if (piece && piece.color === turn) {
        selectedPiece = { r, c };
        validMoves = getValidMoves(r, c);
        renderBoard();
      } else {
        selectedPiece = null;
        validMoves = [];
        renderBoard();
      }
    }

    function executeMove(fromR, fromC, move) {
      const piece = board[fromR][fromC];
      board[move.r][move.c] = piece;
      board[fromR][fromC] = null;

      if (move.jump) {
        board[move.jump.r][move.jump.c] = null;
      }

      if (piece.color === 'red' && move.r === 0) piece.king = true;
      if (piece.color === 'black' && move.r === BOARD_SIZE - 1) piece.king = true;
    }

    function switchTurn() {
      turn = turn === 'red' ? 'black' : 'red';
      updateStatus();
    }

    function botMove() {
      const allMoves = [];
      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          if (board[r][c] && board[r][c].color === 'black') {
            const moves = getValidMoves(r, c);
            moves.forEach(m => allMoves.push({ fromR: r, fromC: c, move: m }));
          }
        }
      }

      if (allMoves.length > 0) {
        const chosen = allMoves[Math.floor(Math.random() * allMoves.length)];
        executeMove(chosen.fromR, chosen.fromC, chosen.move);
        renderBoard();
        checkWin();
        switchTurn();
      }
    }

    function checkWin() {
      let redCount = 0;
      let blackCount = 0;
      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          if (board[r][c]?.color === 'red') redCount++;
          if (board[r][c]?.color === 'black') blackCount++;
        }
      }
      if (redCount === 0) {
        statusText.textContent = "Black (Bot/P2) Wins!";
        gameMode = null;
      } else if (blackCount === 0) {
        statusText.textContent = "Red (Player 1) Wins!";
        gameMode = null;
      }
    }
  </script>
</body>
</html>
