<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Impossible Sans Fight Emulator</title>
    <style>
        body {
            background-color: #000;
            color: #fff;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        #game-container {
            text-align: center;
        }
        #battle-box {
            width: 400px;
            height: 250px;
            border: 4px solid #fff;
            position: relative;
            margin: 20px auto;
            background-color: #000;
            overflow: hidden;
        }
        #heart {
            width: 16px;
            height: 16px;
            position: absolute;
            background-color: #ff0000; /* Red Soul */
            transition: background-color 0.2s;
        }
        .bone {
            position: absolute;
            background-color: #fff;
        }
        #ui {
            font-size: 20px;
            margin-top: 10px;
        }
        #sans-text {
            height: 40px;
            font-size: 18px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<div id="game-container">
    <div id="sans-text">* do you wanna have a REALLY bad time?</div>
    <div id="battle-box">
        <div id="heart"></div>
    </div>
    <div id="ui">
        HP: <span id="hp">99</span> / 99 | MODE: <span id="mode">RED</span>
    </div>
</div>

<script>
    const box = document.getElementById('battle-box');
    const heart = document.getElementById('heart');
    const hpDisplay = document.getElementById('hp');
    const modeDisplay = document.getElementById('mode');
    const sansText = document.getElementById('sans-text');

    // Game State
    let hp = 99;
    let playerX = 192;
    let playerY = 117;
    let playerSpeed = 4;
    let isBlueSoul = false;
    let velocityY = 0;
    const gravity = 0.6;
    const jumpForce = -10;
    
    // Box dimensions boundaries
    const boxWidth = 400;
    const boxHeight = 250;
    const heartSize = 16;

    // Controls tracking
    const keys = {};

    // Obstacles
    let bones = [];

    // Initialize position
    function updateHeartPosition() {
        heart.style.left = playerX + 'px';
        heart.style.top = playerY + 'px';
    }
    updateHeartPosition();

    // Listeners
    window.addEventListener('keydown', (e) => keys[e.key] = true);
    window.addEventListener('keyup', (e) => keys[e.key] = false);

    // Spawn hard projectiles loop
    function spawnBone() {
        const isVertical = Math.random() > 0.5;
        const bone = document.createElement('div');
        bone.classList.add('bone');
        
        let boneData = {};
        
        if (isVertical) {
            // Wall-like tall bone moving horizontally rapidly
            bone.style.width = '15px';
            bone.style.height = '100px';
            bone.style.top = Math.random() > 0.5 ? '0px' : '150px';
            boneData = {
                element: bone,
                x: boxWidth,
                y: parseInt(bone.style.top),
                w: 15,
                h: 100,
                speedX: -(5 + Math.random() * 6), // High speed
                speedY: 0
            };
        } else {
            // Fast ceiling/floor sweeping bone
            bone.style.width = '80px';
            bone.style.height = '15px';
            bone.style.left = Math.random() > 0.5 ? '0px' : '320px';
            boneData = {
                element: bone,
                x: parseInt(bone.style.left),
                y: 0,
                w: 80,
                h: 15,
                speedX: 0,
                speedY: 4 + Math.random() * 4
            };
        }

        box.appendChild(bone);
        bones.push(boneData);
    }

    // Phase shifting mechanics to increase difficulty dynamically
    setInterval(() => {
        spawnBone();
        // Randomly force gravity shift (Sans Blue Soul power)
        if (Math.random() > 0.7) {
            isBlueSoul = !isBlueSoul;
            if (isBlueSoul) {
                heart.style.backgroundColor = '#00a2ff';
                modeDisplay.innerText = "BLUE (GRAVITY)";
                sansText.innerText = "* quick, jump!";
            } else {
                heart.style.backgroundColor = '#ff0000';
                modeDisplay.innerText = "RED (FREE MOVEMENT)";
                sansText.innerText = "* localized gravity distortion over.";
            }
        }
    }, 800);

    // Main Game Loop
    function gameLoop() {
        if (hp <= 0) {
            sansText.innerText = "* told ya.";
            alert("GAY OVER. Click OK to restart.");
            hp = 99;
            bones.forEach(b => b.element.remove());
            bones = [];
            playerX = 192;
            playerY = 117;
            isBlueSoul = false;
            heart.style.backgroundColor = '#ff0000';
        }

        // Movement mechanics
        if (isBlueSoul) {
            // Blue Soul: Horizontal movement + Gravity jump
            if (keys['ArrowLeft'] || keys['a']) playerX -= playerSpeed;
            if (keys['ArrowRight'] || keys['d']) playerX += playerSpeed;
            
            // Jump processing
            if ((keys['ArrowUp'] || keys['w']) && playerY >= boxHeight - heartSize - 2) {
                velocityY = jumpForce;
            }
            
            velocityY += gravity;
            playerY += velocityY;

            // Ground collision
            if (playerY >= boxHeight - heartSize) {
                playerY = boxHeight - heartSize;
                velocityY = 0;
            }
        } else {
            // Red Soul: Omnidirectional Free movement
            if (keys['ArrowLeft'] || keys['a']) playerX -= playerSpeed;
            if (keys['ArrowRight'] || keys['d']) playerX += playerSpeed;
            if (keys['ArrowUp'] || keys['w']) playerY -= playerSpeed;
            if (keys['ArrowDown'] || keys['s']) playerY += playerSpeed;
        }

        // Keep player inside boundary limits
        if (playerX < 0) playerX = 0;
        if (playerX > boxWidth - heartSize) playerX = boxWidth - heartSize;
        if (playerY < 0) playerY = 0;
        if (playerY > boxHeight - heartSize) playerY = boxHeight - heartSize;

        updateHeartPosition();

        // Update and check obstacles
        for (let i = bones.length - 1; i >= 0; i--) {
            let b = bones[i];
            b.x += b.speedX;
            b.y += b.speedY;
            b.element.style.left = b.x + 'px';
            b.element.style.top = b.y + 'px';

            // Collision check (AABB)
            if (
                playerX < b.x + b.w &&
                playerX + heartSize > b.x &&
                playerY < b.y + b.h &&
                playerY + heartSize > b.y
            ) {
                hp -= 1; // "KR" style fast decay
                hpDisplay.innerText = hp;
            }

            // Remove out of bounds bones
            if (b.x < -100 || b.x > boxWidth + 100 || b.y > boxHeight + 100) {
                b.element.remove();
                bones.splice(i, 1);
            }
        }

        requestAnimationFrame(gameLoop);
    }

    // Start loop
    gameLoop();
</script>
</body>
</html>
